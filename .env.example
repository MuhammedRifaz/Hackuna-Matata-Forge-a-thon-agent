# ==============================================================================
# Pacior Code (TrueForge Agent) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your own API keys.
# NEVER commit your real .env file with secrets to version control.
# ==============================================================================

# TrueForge Harness Server (defaults to local daemon)
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_AGENT_NAME=pacior

# Choose your preferred LLM Provider (at least ONE is required by TrueForge)
# Option 1: Google Gemini (Recommended for fast inference & zero token waste)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenRouter (Supports Claude, Nemotron, Llama 3, DeepSeek, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 3: Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 4: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option 5: Local Ollama / vLLM (Zero API Key required)
# OLLAMA_BASE_URL=http://localhost:11434

